IDENTIFICATION DIVISION.
PROGRAM-ID. CARDDEMO-INTEREST.

DATA DIVISION.
WORKING-STORAGE SECTION.
01 ARGUMENT-COUNT PIC 9(4) COMP-5 VALUE ZERO.
01 BALANCE-ARG PIC X(64) VALUE SPACES.
01 RATE-ARG PIC X(64) VALUE SPACES.
01 BALANCE-TEXT PIC X(64) VALUE SPACES.
01 RATE-TEXT PIC X(64) VALUE SPACES.
01 BALANCE-LENGTH PIC 9(4) COMP-5 VALUE ZERO.
01 RATE-LENGTH PIC 9(4) COMP-5 VALUE ZERO.
01 DIGIT-START PIC 9(4) COMP-5 VALUE ZERO.
01 DECIMAL-POSITION PIC 9(4) COMP-5 VALUE ZERO.
01 INTEGRAL-LENGTH PIC 9(4) COMP-5 VALUE ZERO.
01 INPUT-INVALID PIC X VALUE "N".
01 INPUT-OVERFLOW PIC X VALUE "N".

*> These declarations preserve the relevant CardDemo field shapes.
01 TRAN-CAT-BAL PIC S9(09)V99 VALUE ZERO.
01 DIS-INT-RATE PIC S9(04)V99 VALUE ZERO.
01 WS-MONTHLY-INT PIC S9(09)V99 VALUE ZERO.
01 WIDE-RESULT PIC S9(15)V9(8) COMP-3 VALUE ZERO.
01 TRUNC-RESULT PIC S9(15)V99 COMP-3 VALUE ZERO.
01 OUTPUT-MAGNITUDE PIC 9(09)V99 VALUE ZERO.
01 OUTPUT-TEXT PIC ZZZZZZZZ9.99.

PROCEDURE DIVISION.
MAIN.
    ACCEPT ARGUMENT-COUNT FROM ARGUMENT-NUMBER
    IF ARGUMENT-COUNT NOT = 2
        PERFORM EMIT-INVALID
    END-IF

    ACCEPT BALANCE-ARG FROM ARGUMENT-VALUE
    ACCEPT RATE-ARG FROM ARGUMENT-VALUE
    MOVE FUNCTION TRIM(BALANCE-ARG) TO BALANCE-TEXT
    MOVE FUNCTION TRIM(RATE-ARG) TO RATE-TEXT
    COMPUTE BALANCE-LENGTH = FUNCTION LENGTH(FUNCTION TRIM(BALANCE-ARG))
    COMPUTE RATE-LENGTH = FUNCTION LENGTH(FUNCTION TRIM(RATE-ARG))

    PERFORM VALIDATE-BALANCE
    PERFORM VALIDATE-RATE

    IF INPUT-OVERFLOW = "Y"
        PERFORM EMIT-OVERFLOW
    END-IF
    IF INPUT-INVALID = "Y"
        PERFORM EMIT-INVALID
    END-IF

    MOVE FUNCTION NUMVAL(BALANCE-TEXT(1:BALANCE-LENGTH)) TO TRAN-CAT-BAL
    MOVE FUNCTION NUMVAL(RATE-TEXT(1:RATE-LENGTH)) TO DIS-INT-RATE

    COMPUTE WIDE-RESULT = (TRAN-CAT-BAL * DIS-INT-RATE) / 1200
    COMPUTE TRUNC-RESULT = WIDE-RESULT
    IF TRUNC-RESULT > 999999999.99 OR TRUNC-RESULT < -999999999.99
        PERFORM EMIT-OVERFLOW
    END-IF

    *> Exact bounded expression from CBACT04C.cbl lines 464-465.
    *> No ROUNDED phrase: assignment truncates excess fractional digits.
    COMPUTE WS-MONTHLY-INT
        = (TRAN-CAT-BAL * DIS-INT-RATE) / 1200

    IF WS-MONTHLY-INT < ZERO
        COMPUTE OUTPUT-MAGNITUDE = ZERO - WS-MONTHLY-INT
        MOVE OUTPUT-MAGNITUDE TO OUTPUT-TEXT
        DISPLAY "OK" X"09" "-" FUNCTION TRIM(OUTPUT-TEXT)
    ELSE
        MOVE WS-MONTHLY-INT TO OUTPUT-TEXT
        DISPLAY "OK" X"09" FUNCTION TRIM(OUTPUT-TEXT)
    END-IF
    MOVE 0 TO RETURN-CODE
    GOBACK.

VALIDATE-BALANCE.
    MOVE 1 TO DIGIT-START
    IF BALANCE-LENGTH < 4
        MOVE "Y" TO INPUT-INVALID
        EXIT PARAGRAPH
    END-IF
    IF BALANCE-TEXT(1:1) = "+" OR BALANCE-TEXT(1:1) = "-"
        MOVE 2 TO DIGIT-START
    END-IF
    COMPUTE DECIMAL-POSITION = BALANCE-LENGTH - 2
    COMPUTE INTEGRAL-LENGTH = DECIMAL-POSITION - DIGIT-START
    IF INTEGRAL-LENGTH < 1
        MOVE "Y" TO INPUT-INVALID
        EXIT PARAGRAPH
    END-IF
    IF INTEGRAL-LENGTH > 9
        MOVE "Y" TO INPUT-OVERFLOW
        EXIT PARAGRAPH
    END-IF
    IF BALANCE-TEXT(DECIMAL-POSITION:1) NOT = "."
        MOVE "Y" TO INPUT-INVALID
        EXIT PARAGRAPH
    END-IF
    IF BALANCE-TEXT(DIGIT-START:INTEGRAL-LENGTH) IS NOT NUMERIC
        MOVE "Y" TO INPUT-INVALID
        EXIT PARAGRAPH
    END-IF
    IF BALANCE-TEXT(DECIMAL-POSITION + 1:2) IS NOT NUMERIC
        MOVE "Y" TO INPUT-INVALID
    END-IF.

VALIDATE-RATE.
    MOVE 1 TO DIGIT-START
    IF RATE-LENGTH < 4
        MOVE "Y" TO INPUT-INVALID
        EXIT PARAGRAPH
    END-IF
    IF RATE-TEXT(1:1) = "+" OR RATE-TEXT(1:1) = "-"
        MOVE 2 TO DIGIT-START
    END-IF
    COMPUTE DECIMAL-POSITION = RATE-LENGTH - 2
    COMPUTE INTEGRAL-LENGTH = DECIMAL-POSITION - DIGIT-START
    IF INTEGRAL-LENGTH < 1
        MOVE "Y" TO INPUT-INVALID
        EXIT PARAGRAPH
    END-IF
    IF INTEGRAL-LENGTH > 4
        MOVE "Y" TO INPUT-OVERFLOW
        EXIT PARAGRAPH
    END-IF
    IF RATE-TEXT(DECIMAL-POSITION:1) NOT = "."
        MOVE "Y" TO INPUT-INVALID
        EXIT PARAGRAPH
    END-IF
    IF RATE-TEXT(DIGIT-START:INTEGRAL-LENGTH) IS NOT NUMERIC
        MOVE "Y" TO INPUT-INVALID
        EXIT PARAGRAPH
    END-IF
    IF RATE-TEXT(DECIMAL-POSITION + 1:2) IS NOT NUMERIC
        MOVE "Y" TO INPUT-INVALID
    END-IF.

EMIT-INVALID.
    DISPLAY "ERROR" X"09" "INVALID_INPUT"
    MOVE 2 TO RETURN-CODE
    GOBACK.

EMIT-OVERFLOW.
    DISPLAY "ERROR" X"09" "OVERFLOW"
    MOVE 3 TO RETURN-CODE
    GOBACK.
